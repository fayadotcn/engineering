# 数据库与文件存储（本项目默认值）
DATABASE_URL="file:./dev.db"
STORAGE_DIR="./storage"

# 模型配置（可选；不配也能用：对话走内置规则引擎）
# 三选一：openai-compatible（含 deepseek/自建网关）| anthropic | rule（强制规则引擎）
MODEL_PROVIDER="openai-compatible"
MODEL_BASE_URL="https://api.deepseek.com"
MODEL_API_KEY=""
MODEL_NAME="deepseek-chat"
# 只给 DEEPSEEK_API_KEY 也行：自动按官方端点 + deepseek-chat 兜底
# DEEPSEEK_API_KEY=""
