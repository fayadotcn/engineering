  "private": true,
  "scripts": {
    "dev": "node scripts/run-harness.mjs --dev",
    "web:url": "node scripts/web-url.mjs",
    "build": "prisma generate && node scripts/build-harness.mjs && next build",
    "start": "node scripts/run-harness.mjs",
    "harness:build": "node scripts/build-harness.mjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "typecheck": "tsc --noEmit && tsc -p harness/tsconfig.client.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
