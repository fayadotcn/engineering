// Postgres-portable schema. SQLite in dev: enums and Json are stored as String,
// serialized/deserialized by shared/json helpers. Decimal is Prisma-supported.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  name        String
  status      String        @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  files       ProjectFile[]
  boqItems    BoqItem[]
  quotations  QuotationItem[]
  facts       CostFact[]
  runs        AgentRun[]
  artifacts   Artifact[]
}

model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  filename   String
  mime       String
  storageKey String
  sizeBytes  Int
  kind       String   @default("UNKNOWN")
  // BOQ_TENDER | BOQ_WINNING | BOQ_SETTLEMENT | MATERIAL_QUOTATION
  // OWNER_SUPPLIED | CONTRACT | CHANGE | VISA | DRAWING | UNKNOWN
  status     String   @default("UPLOADED") // UPLOADED | PARSED | FAILED
  meta       String   @default("{}") // JSON: sheets, rowCounts, parseReport, mapping
  contentHash String  @default("") // sha1(buffer)，同项目重复上传去重
  stage      String   @default("") // 文件阶段：招标|投标|报审|变更签证|进度计量|结算 等（inferFileStage）
  period     String   @default("") // 计价期次 YYYY-MM（文件名提取），进度款「本期/上期」对审用
  createdAt  DateTime @default(now())
  boqItems   BoqItem[]
  quotations QuotationItem[]

  @@index([projectId])
}

model BoqItem {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  fileId        String?
  file          ProjectFile? @relation(fields: [fileId], references: [id])
  sheetName     String
  rowIndex      Int      // original excel row for write-back
  code          String   @default("")
  name          String
  rawFeature    String   @default("")
  unit          String   @default("")
  quantity      Decimal  @default(0)
  // 工程量计算式留痕：手填/助手用计算式（3层×12个+15）得出的工程量存原文，复核可查
  quantityExpr  String   @default("")
  unitPrice     Decimal  @default(0)   // 综合单价（人材机管利五要素），不是材料价
  mainMaterialPrice Decimal @default(0) // 主材/设备暂估价（询价或信息价，组价输入）
  // 来源表自带的人材机分解列（综合单价分析表口径，每清单单位）。
  // 成本构成分析（cost.composition）的直接输入；0 = 源表无该列
  laborUnitPrice   Decimal @default(0) // 人工费单价
  machineUnitPrice Decimal @default(0) // 机械费单价
  pricingPlan   String   @default("[]") // JSON PricingPlanLine[]：组价方案（一清单项可挂多定额子目）
  totalPrice    Decimal  @default(0)
  feeType       String   @default("分部分项") // 分部分项 | 单价措施 | 总价措施 | 其他项目 | 规费税金
  sectionPath   String   @default("") // e.g. "电气设备安装工程/配电箱"
  unitProject   String   @default("") // 单位工程（分部分项表【…】/「单位工程：X」行内字段提取）
  taxIncluded   Boolean  @default(false) // 源表为含税单价（表头含「含税」），费用汇总不重复计税
  isHeader      Boolean  @default(false)
  sortOrder     Int      @default(0)
  discipline    String   @default("OTHER")
  // ELECTRICAL | PLUMBING | FIRE | HVAC | WEAK_CURRENT | OTHER
  features      String   @default("{}") // JSON BoqSemanticFeature
  // 原始单元格 {表头标签或列字母: 文本} + __nonNumeric: string[] + __derived: string[]
  rawCells      String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, code])
  @@index([projectId, discipline])
  @@index([fileId])
}

// 已确认的列映射模板：表头指纹 → 列角色/表类型，再次遇到同构表格直接套用
model ImportTemplate {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  headerText  String
  sheetType   String   // BOQ | QUOTATION | GENERIC
  columns     String   @default("{}") // JSON role -> col
  useCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuotationItem {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  fileId       String?
  file         ProjectFile? @relation(fields: [fileId], references: [id])
  materialName String
  spec         String   @default("")
  unit         String   @default("")
  brand        String   @default("")
  price        Decimal  @default(0)
  sheetName    String   @default("")
  rowIndex     Int      @default(0)
  features     String   @default("{}")
  raw          String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([fileId])
}

model CostFact {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  factType     String   // REGION | TAX_RATE | BRAND | PRICE_FILE | PRICE_DATE | CURRENCY | STANDARD | CUSTOM
  key          String
  value        String
  source       String   // USER_PROVIDED | FILE_EXTRACTED | CONTRACT_DEFINED | HISTORICAL | INFERRED | MARKET_REFERENCE
  sourceFileId String?
  confidence   Float    @default(1)
  effectiveDate DateTime?
  createdBy    String   @default("agent") // agent | user
  agentRunId   String?
  createdAt    DateTime @default(now())

  @@index([projectId, factType, key])
}

model AgentRun {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  userMessage String
  status      String   @default("RUNNING") // RUNNING | AWAITING_CONFIRM | DONE | FAILED
  planner     String   @default("rule")    // rule | llm | import（确定性文件导入）| harness（已下线的旧会话，仅历史数据）
  pendingAction String @default("{}")    // JSON {confirmId,tool,args,description} while AWAITING_CONFIRM
  summary     String   @default("")
  createdAt   DateTime @default(now())
  finishedAt  DateTime?
  events      AgentEvent[]
  toolCalls   ToolCall[]
  receipts    ActionReceipt[]

  @@index([projectId])
}

model AgentEvent {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id])
  seq       Int
  type      String   // activity | message | tool_started | tool_finished | workspace_patch | receipt | run_finished | error
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([runId, seq])
}

model ToolCall {
  id         String   @id @default(cuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id])
  tool       String
  args       String   @default("{}")
  result     String   @default("{}")
  status     String   @default("OK") // OK | ERROR
  projectId  String
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([runId])
}

model ActionReceipt {
  id         String   @id @default(cuid())
  runId      String?
  run        AgentRun? @relation(fields: [runId], references: [id])
  toolCallId String?
  projectId  String
  actionType String   // BOQ_UPDATE | PRICE_APPLY | QUANTITY_ADJUST | FILE_IMPORT | EXPORT | USER_EDIT | FACT_SET
  summary    String
  before     String   @default("{}")
  after      String   @default("{}")
  reversible Boolean  @default(true)
  createdBy  String   @default("agent")
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model Artifact {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  kind        String   // EXPORT_EXCEL | REPORT
  label       String
  storageKey  String
  createdByRunId String?
  createdAt   DateTime @default(now())

  @@index([projectId])
}

/* ---------------- 后台数据管理：全局共享数据集 ---------------- */

model Dataset {
  id         String   @id @default(cuid())
  kind       String   // MATERIAL_PRICE | QUOTA | GENERIC
  name       String
  filename   String
  storageKey String
  sizeBytes  Int      @default(0)
  status     String   @default("PARSED") // PENDING | PARSED | FAILED（PENDING=已识别待管理员确认映射后导入）
  active     Boolean  @default(true)   // 停用后不参与匹配/测算，但数据保留
  rowCount   Int      @default(0)
  meta       String   @default("{}") // JSON: sheets, mapping, defaults, errors
  contentHash String  @default("") // sha1(buffer)，同 kind 重复上传去重
  createdAt  DateTime @default(now())
  materialPrices MaterialPrice[]
  quotaRows       QuotaRow[]
}

// 材料价格库：跨项目共享的信息价/市场价/供应商价
model MaterialPrice {
  id        String   @id @default(cuid())
  datasetId String?
  dataset   Dataset? @relation(fields: [datasetId], references: [id])
  name      String
  spec      String   @default("")
  unit      String   @default("")
  brand     String   @default("")
  price     Decimal  @default(0)
  priceType String   @default("MARKET") // MARKET | INFO | SUPPLY
  region    String   @default("")
  period    String   @default("") // 价格期，如 2024-06
  features  String   @default("{}") // JSON BoqSemanticFeature
  raw       String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([brand])
  @@index([datasetId])
}

// 定额库：消耗量定额子目（人工/辅材/机械 + 主材耗量）
// 定额说明/计算规则条文（从定额说明PDF提取，按册-章分节，供匹配存疑时检索）
model SpecSection {
  id        String   @id @default(cuid())
  book      String   // 册，如 "C.H 工业管道工程" / "A 房屋建筑与装饰"
  title     String   // 节标题，如 "第一章 给排水管道" 或 "册说明"
  content   String   // 正文（条文文本）
  /** 语料来源：sc2020=2020定额说明PDF | sc2015=2015定额手册CHM | qd=清单项目库(GB 清单编码级工程内容) */
  source    String   @default("sc2020")
  orderIdx  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([book])
  @@index([source])
}

// 历史工程定额套用经验库（宏业 GCFX 工程文件解析沉淀，scripts/import-gcfx-usage.ts 导入）
// 主键 itemKey = 归一化「名称模式|单位」桶；清单编码不可靠（自编/错填常见）不作键
model UsageStat {
  id        String   @id @default(cuid())
  itemKey   String   // 归一化名称模式|单位
  itemName  String   // 桶内代表清单名
  quotaCode String   // 内部归并码（去 换/补/T 后缀）
  applied   String   @default("") // 文件里显示的定额编号（如 CJ0199、CD2328换）
  quotaName String
  unit      String   @default("")
  uses      Int      @default(0)  // 套用次数
  projects  Int      @default(0)  // 独立项目数（可信度主依据）
  conv      Int      @default(0)  // 其中换算次数
  flag      String   @default("rare") // common | rare | suspect（孤例且桶内有共识）
  specs     String   @default("[]")   // JSON 规格档 top：DN150/Φ12…
  mats      String   @default("[]")   // JSON 常见主材 top
  samples   String   @default("[]")   // JSON 来源工程文件名 top（溯源）
  updatedAt DateTime @updatedAt

  @@index([itemKey])
  @@index([quotaCode])
}

// 组合套用：一清单挂多定额（制作+安装 / 敷设+防腐），整体频次比单定额更说明套法
model UsageCombo {
  id        String   @id @default(cuid())
  itemKey   String
  itemName  String
  lines     String   @default("[]") // JSON [{code,applied,name,unit,conv}] 按套用顺序
  uses      Int      @default(0)
  projects  Int      @default(0)
  flag      String   @default("rare")
  updatedAt DateTime @updatedAt

  @@index([itemKey])
}

model QuotaRow {
  id            String   @id @default(cuid())
  datasetId     String?
  dataset       Dataset? @relation(fields: [datasetId], references: [id])
  code          String
  name          String
  unit          String   @default("")
  unitScale     Float    @default(1) // 定额单位倍数：10m→10
  labor         Decimal  @default(0)
  material      Decimal  @default(0)
  machine       Decimal  @default(0)
  mainQtyPerUnit Float   @default(1) // 主材耗量/每清单单位
  // 全部未计价材料（az_yl 用料表）：[{name,unit,qtyPerUnit}]，按定额单位倍数折算为每清单单位。
  // 管件/法兰/配件/多主材（如坐便器=便器+水箱+配件+桶盖）都在这里——mainQtyPerUnit 只是首个主材
  materials     String   @default("[]")
  matchKeys     String   @default("{}") // JSON: 从名称解析出的语义特征（匹配依据）
  raw           String   @default("{}")
  createdAt     DateTime @default(now())

  @@index([code])
  @@index([datasetId])
}

// 语义匹配沉淀：模型判出的等价品名（别名→规范名）。
// 检索端把 canonical 当额外名称键、打分端当等效名——别名命中后走纯 SQL/纯函数路径，
// 与代码内词表不同：它是数据、可审计可删、由判定自动生长。source: LLM | MANUAL
model MaterialAlias {
  id        String   @id @default(cuid())
  normKey   String   @unique  // normalizeNameKey 归一后的别名词
  canonical String            // 规范品名（库内检索键，如「大便器」）
  source    String   @default("LLM")
  model     String   @default("")
  createdAt DateTime @default(now())
}

// 语义判定缓存：queryKey(归一名|归一规格|单位) × 库行 → 同品与否。
// 让重跑确定且零模型成本；模型名留痕便于换模型后失效重判。
model MaterialMatchVerdict {
  id        String   @id @default(cuid())
  queryKey  String
  rowId     String
  same      Boolean
  model     String   @default("")
  createdAt DateTime @default(now())

  @@unique([queryKey, rowId])
  @@index([queryKey])
}
