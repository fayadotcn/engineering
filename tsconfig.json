{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@agent/*": ["./agent/*"],
      "@cost-engine/*": ["./cost-engine/*"],
      "@boq/*": ["./boq/*"],
      "@material/*": ["./material/*"],
      "@quota/*": ["./quota/*"],
      "@project/*": ["./project/*"],
      "@file/*": ["./file/*"],
      "@report/*": ["./report/*"],
      "@workspace/*": ["./workspace/*"],
      "@database/*": ["./database/*"],
      "@dataset/*": ["./dataset/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
